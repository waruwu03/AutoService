# ==============================================================================
# AUTOSERVIS SYSTEM - GLOBAL ENV CONFIGURATION (DOCKER)
# Duplicate this file to '.env' at the root of the project before deploying.
# ==============================================================================

# --- DATABASE CONFIGURATION ---
DB_ROOT_PASSWORD=strongrootpassword123
DB_NAME=autoservis
DB_USER=autoservis_user
DB_PASSWORD=stronguserpassword123
DB_HOST_PORT=3307

# --- CACHE CONFIGURATION ---
REDIS_HOST_PORT=6379

# --- STORAGE CONFIGURATION (MINIO / S3) ---
S3_HOST_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=autoservis

# --- BACKEND SERVICE CONFIGURATION ---
BACKEND_PORT=3002
BACKEND_HOST_PORT=3002
API_PREFIX=/api/v1
LOG_LEVEL=info

# --- AUTHENTICATION (JWT) ---
# Generate strong random keys for production (e.g. openssl rand -base64 32)
JWT_SECRET=supersecretjwtkeyforautoservisproduction321
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=supersecretrefreshjwtkeyforautoservisproduction789
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS & NETWORK ---
CORS_ORIGIN=http://localhost:3000

# --- THIRD PARTY INTEGRATIONS (OPTIONAL) ---
# Gemini AI
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# WhatsApp API Gateway (e.g., Fonnte or official Meta API)
WHATSAPP_API_KEY=YOUR_WHATSAPP_API_KEY_HERE
WHATSAPP_PHONE_ID=YOUR_WHATSAPP_PHONE_ID_HERE

# --- FRONTEND SERVICE CONFIGURATION ---
FRONTEND_HOST_PORT=3000
# Note: For client-side rendering, NEXT_PUBLIC_API_URL must be the URL
# accessible by the browser (e.g., http://yourdomain.com:3002/api/v1 or https://yourdomain.com/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:3002/api/v1
